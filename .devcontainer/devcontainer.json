{
  "name": "nievespg-devcontainer",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "containerEnv": {
    "GH_CONFIG_DIR": "/home/vscode/.config/gh-devcontainer",
    "CLAUDE_CODE_SETTINGS": "/mnt/c/Users/gabri/.claude/settings.json"
  },
  "runArgs": [
    "--gpus",
    "all",
    "--mount",
    "type=bind,source=C:\\,target=/mnt/c,consistency=cached",
    "--mount",
    "type=bind,source=F:\\,target=/mnt/ssd,consistency=cached",
    "--mount",
    "type=bind,source=S:\\,target=/mnt/hdd,consistency=cached"
  ],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/nievespg,type=bind,consistency=cached",
  "workspaceFolder": "/workspace/nievespg",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash",
        "python.defaultInterpreterPath": "/home/vscode/micromamba/envs/nievespg/bin/python"
      },
      "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python",
        "tamasfe.even-better-toml",
        "astro-build.astro-vscode"
      ]
    }
  },
  "initializeCommand": ["powershell.exe", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${localWorkspaceFolder}/.devcontainer/scripts/export_gh_auth.ps1"],
  "mounts": [
    "source=${localEnv:APPDATA}/nievespg-devcontainer/gh,target=/mnt/host-gh,type=bind,readonly"
  ],
  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh",
  "postStartCommand": "bash .devcontainer/scripts/sync_gh_auth.sh",
  "remoteUser": "vscode"
}
